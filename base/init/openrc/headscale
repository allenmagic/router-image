#!/sbin/openrc-run
# ============================================================
# headscale —— 自建 Tailscale 控制面的第二客户端实例（接口 ts0）
#
# 与官方 Tailscale 控制面（tailscale0，base/init/openrc/tailscale）
# 并存。结构与官方实例完全对称（--config 显式传 + config.json 驱动
# 全部登录参数 + 裸 tailscale up），差异只在：
#   - daemon 级参数必须显式错开：state/socket 用 /var/lib/headscale
#     （镜像内符号链接 → /run/router-vm/headscale，与官方实例同构的
#     易失语义——重启即清、新节点重新注册，key 需 reusable+ephemeral）、
#     UDP 41642（官方 41641）、TUN ts0
#   - config.json（/etc/headscale/config.json）含 serverURL 字段
#     （netfilterMode 也由 config.json 承载，第二实例与官方实例同为 "off"、
#     不接管防火墙链），指向自建 Headscale（__HEADSCALE_CTL_URL__，
#     network.sh 按 network.env 替换）
#
# authkey 由 router-vm-deploy 注入 /etc/headscale/authkey（链接 →
# /run/router-vm/headscale/authkey），见 deploy-assets/lib/secrets.sh。
# nftables 的 @vpn_interfaces 集合与 TS_PORT 放行已预留 ts0/41642。
# ============================================================

name=$RC_SVCNAME
description="Headscale client (second tailscaled instance, ts0)"

pidfile="/run/router-vm/$name.pid"

depend() {
    need run-state net
    after firewall
    use logger
}

start_pre() {
    mkdir -p /var/lib/headscale
}

start() {
    # 预检：tailscaled 在位 + authkey 已注入；不满足则跳过（stopped，不 crash）
    [ -x /usr/sbin/tailscaled ] || { eerror "tailscaled 未安装"; return 1; }
    if [ ! -s /etc/headscale/authkey ]; then
        ewarn "未注入 Headscale authkey，跳过启动（等待 router-vm-deploy 注入）"
        return 1
    fi
    # --config 必须显式传（与官方实例同构；config.json 不会自动读）。
    # daemon 级参数（state/socket/port/tun）config.json 不承载，仍需 CLI。
    # state/socket 都走标准路径 /var/lib/headscale（setup.sh 烙链接 →
    # state/lib/headscale，宿主 stateDisk 时持久）；socket 是运行时 IPC，
    # daemon 每次启动 unlink 重建，落盘无害
    ebegin "Starting headscale tailscaled (ts0, UDP 41642)"
    start-stop-daemon --start --quiet --background --make-pidfile --pidfile "$pidfile" \
        --exec /usr/sbin/tailscaled -- \
        --config=/etc/headscale/config.json \
        --state=/var/lib/headscale/tailscaled.state \
        --socket=/var/lib/headscale/tailscaled.sock \
        --port=41642 \
        --tun=ts0
    eend $?
}

stop() {
    ebegin "Stopping headscale tailscaled"
    start-stop-daemon --stop --quiet --pidfile "$pidfile"
    eend $?
}

#!/sbin/openrc-run

name=$RC_SVCNAME
description="Tailscale agent"

pidfile="/run/router-vm/$name.pid"

depend() {
    need net
    after firewall
    use logger
}

start_pre() {
    mkdir -p /var/lib/tailscale /run/router-vm/tailscale
}

start() {
    # 预检：应用安装 + 配置完整（authkey 已注入）；不满足则跳过（stopped，不 crash）
    [ -x /usr/sbin/tailscaled ] || { eerror "tailscaled 未安装"; return 1; }
    if [ ! -s /etc/tailscale/authkey ]; then
        ewarn "未注入 Tailscale authkey，跳过启动（等待 router-vm-deploy 注入）"
        return 1
    fi
    # --config 必须显式传：tailscaled 不会自动读默认路径。缺它时
    # config.json 的全部字段（netfilterMode=off / authKey file: /
    # acceptRoutes / advertiseRoutes / acceptDNS）静默失效——
    # nftables 环境建 ts-input 链失败、登录后 Logged out
    # （见 docs/headscale-login-plan.md §2 根因分析）
    ebegin "Starting tailscaled"
    start-stop-daemon --start --quiet --background --make-pidfile --pidfile "$pidfile" \
        --exec /usr/sbin/tailscaled -- --config=/etc/tailscale/config.json
    eend $?
}

stop() {
    ebegin "Stopping tailscaled"
    start-stop-daemon --stop --quiet --pidfile "$pidfile"
    eend $?
}
